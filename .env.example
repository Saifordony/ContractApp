# ---- App ----
APP_NAME=Contract Analysis Platform
ENVIRONMENT=development
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- MongoDB ----
MONGODB_URL=mongodb://admin:admin123@localhost:27017/contract_analysis?authSource=admin
MONGODB_DB=contract_analysis

# ---- Auth ----
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_EXPIRE_MINUTES=30
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Dev/no-mail mode: return password-reset tokens in the API response.
EXPOSE_RESET_TOKEN=true

# ---- Ollama (local LLM, OpenAI-compatible API) ----
# Local backend:        http://localhost:11434/v1
# Backend in Docker:    http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=120

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
