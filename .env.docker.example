# Docker Compose defaults. Backend container reaches host Ollama via host.docker.internal.
JWT_SECRET=change-me-docker-dev-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MONGODB_DB=contract_analysis
API_BASE_URL=http://backend:8000
OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_MODE=simple
OLLAMA_ENABLED=true
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=60
ANALYSIS_FAST_MODE=true
ANALYSIS_JOB_TIMEOUT_SECONDS=180
FRONTEND_API_TIMEOUT_SECONDS=300
CORS_ORIGINS=http://localhost:8501
